{
  "type_definitions": [
    {
      "type": "Page/container",
      "examples": "DiscoverPage, LivePage, CatalogPage",
      "document_at": "Page specification",
      "purpose": "Top-level route component"
    },
    {
      "type": "Feature module",
      "examples": "ReleaseWizard, BroadcastDashboard, RoyaltyEngine",
      "document_at": "Feature specification",
      "purpose": "Domain-specific workflow component"
    },
    {
      "type": "Reusable domain UI",
      "examples": "SplitManager, AssetUploader, SearchBar",
      "document_at": "Component catalog",
      "purpose": "Reusable across multiple features"
    },
    {
      "type": "Primitive UI",
      "examples": "Button, Modal, TextInput, Select, Tabs",
      "document_at": "Design system",
      "purpose": "Base UI components"
    },
    {
      "type": "Domain service",
      "examples": "Recommendation engine, royalty calculation, entitlement logic",
      "document_at": "Architecture/service documentation",
      "purpose": "Backend business logic"
    },
    {
      "type": "External adapter",
      "examples": "RTMP ingest, payment processor, DSP delivery connector",
      "document_at": "Integration documentation",
      "purpose": "Third-party integration"
    }
