generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ApiKey {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id String?        @db.Uuid
  user_id         String?        @db.Uuid
  name            String
  label           String?
  key_hash        String         @unique
  prefix          String?
  last_four       String?
  scopes          String[]
  last_used       DateTime?      @db.Timestamptz(6)
  last_used_ip    String?
  expires_at      DateTime?      @db.Timestamptz(6)
  revoked         Boolean?       @default(false)
  revoked_at      DateTime?      @db.Timestamptz(6)
  created_at      DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?      @default(now()) @db.Timestamptz(6)
  api_key_events  ApiKeyEvent[]
  organizations   organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users?         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usage_daily     UsageDaily[]

  @@index([key_hash], map: "idx_api_keys_key_hash")
  @@index([organization_id], map: "idx_api_keys_organization_id")
  @@index([user_id], map: "idx_api_keys_user_id")
  @@map("api_keys")
}

model ApiKeyEvent {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  api_key_id  String    @db.Uuid
  user_id     String?   @db.Uuid
  method      String
  path        String
  status      Int
  duration_ms Int       @default(0)
  bytes_in    Int?      @default(0)
  bytes_out   Int?      @default(0)
  error_code  String?
  request_id  String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  api_keys    ApiKey    @relation(fields: [api_key_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([api_key_id], map: "idx_api_key_events_api_key_id")
  @@index([created_at], map: "idx_api_key_events_created_at")
  @@map("api_key_events")
}

model UsageDaily {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  api_key_id    String    @db.Uuid
  user_id       String?   @db.Uuid
  day           DateTime  @db.Date
  request_count Int       @default(0)
  error_count   Int       @default(0)
  bytes_in      BigInt?   @default(0)
  bytes_out     BigInt?   @default(0)
  p50_ms        Int?      @default(0)
  p95_ms        Int?      @default(0)
  p99_ms        Int?      @default(0)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  api_keys      ApiKey    @relation(fields: [api_key_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([api_key_id, day])
  @@index([api_key_id], map: "idx_usage_daily_api_key_id")
  @@index([day], map: "idx_usage_daily_day")
  @@index([user_id], map: "idx_usage_daily_user_id")
  @@map("usage_daily")
}

